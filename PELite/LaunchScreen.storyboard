                        <viewLayoutGuide key="safeArea" id="sa"/>
                        <constraints>
                            <constraint firstItem="l" firstAttribute="centerX" secondItem="v" secondAttribute="centerX" id="c1"/>
                            <constraint firstItem="l" firstAttribute="centerY" secondItem="v" secondAttribute="centerY" id="c2"/>
