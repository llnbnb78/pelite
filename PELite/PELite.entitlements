<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key><string>$(AppIdentifierPrefix)com.pe.skinlite</string>
	<key>com.apple.developer.team-identifier</key><string>$(TeamIdentifierPrefix)</string>
	<key>get-task-allow</key><false/>
	<key>keychain-access-groups</key><array><string>$(AppIdentifierPrefix)com.pe.skinlite</string></array>
	<key>com.apple.security.application-groups</key><array><string>group.com.pe.skinlite</string></array>
</dict>
</plist>
